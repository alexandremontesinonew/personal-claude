# Claude Desktop Automator - Environment Variables
# Copy this file to .env and customize as needed

# Tesseract OCR Path (if not in system PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Custom Config Path
# CONFIG_PATH=config/config.yaml

# Override logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Override window title to search for
# CLAUDE_WINDOW_TITLE=Claude

# API Keys or other sensitive data (if needed for extensions)
# API_KEY=your_api_key_here
